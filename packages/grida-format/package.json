{
  "name": "@grida/format",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "flatc:clean": "node -e \"const fs=require('node:fs'); for (const p of ['src/grida','src/grida.ts']) fs.rmSync(p, { recursive: true, force: true });\"",
    "flatc:generate": "pnpm flatc:clean && python3 ../../bin/activate-flatc -- --ts --ts-no-import-ext -o src ../../format/grida.fbs",
    "generate": "pnpm flatc:generate",
    "prebuild": "pnpm flatc:generate",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "flatbuffers": "^25.9.23"
  }
}
