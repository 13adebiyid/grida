{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@grida/io": ["../grida-canvas-io/index.ts"]
    },
    "ignoreDeprecations": "6.0",
    "lib": ["dom", "es2022"],
    "esModuleInterop": true,
    "noImplicitAny": true,
    "strict": true,
    "skipLibCheck": true
  },
  "exclude": ["dist"]
}
